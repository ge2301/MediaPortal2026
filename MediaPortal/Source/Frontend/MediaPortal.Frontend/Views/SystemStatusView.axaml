<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        xmlns:theming="clr-namespace:MediaPortal.Frontend.Theming"
        x:Class="MediaPortal.Frontend.Views.SystemStatusView"
        x:DataType="vm:SystemStatusViewModel"
        Name="systemStatus"
        Background="Transparent"
        >

  <!--
    The system lines as a section of the hub: what this box and the server behind it are made of, each read
    from the running thing it names. No heading and no saying of its own - the corner word at the foot of the
    window already names the room, and a paragraph about the screen being a status screen says nothing. One
    list, walked by the arrows; the lines are read when the section opens.
  -->

  <ListBox Name="linesList" Margin="48,14"
           Classes="nereus-status-rows"
           theming:SkinTemplates.TileTemplate="StatusRowTemplate"
           Focusable="True"
           ItemsSource="{Binding Lines}"
           FontSize="18">
    <ListBox.ItemTemplate>
      <DataTemplate x:DataType="vm:SystemStatusViewModel+Line">
        <Grid ColumnDefinitions="260,*" ColumnSpacing="16" Margin="2,5">
          <TextBlock Grid.Column="0"
                     Text="{Binding Label}"
                     FontSize="17"
                     Opacity="0.6" />
          <TextBlock Grid.Column="1"
                     Text="{Binding Value}"
                     FontSize="18"
                     TextWrapping="Wrap" />
        </Grid>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
